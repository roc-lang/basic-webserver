app [Model, program] { pf: platform "../platform/main.roc" }

import pf.Stdout
import pf.Dir
import pf.File
import pf.Cmd
import pf.Http

Model : {}

program = { init!, respond! }

init! : {} => Try(Model, [Exit(I64), ..])
init! = |{}|
    match run_tests!({}) {
        Ok(_) => {
            _ = cleanup_test_dirs!(DirsNeedToExist)
            _ = Stdout.line!("Ran all tests.")
            Err(Exit(0))
        }
        Err(err) => {
            _ = cleanup_test_dirs!(DirsMaybeExist)
            _ = Stdout.line!("Test run failed:\n\t${Str.inspect(err)}")
            Err(Exit(1))
        }
    }

run_tests! = |{}| {
    Stdout.line!("Testing Dir functions...\nThis will create and manipulate test directories in the current directory.\n")?

    # Test Dir.create!
    test_dir_create!({})?

    # Test Dir.create_all!
    test_dir_create_all!({})?

    # Test Dir.delete_empty!
    test_dir_delete_empty!({})?

    # Test Dir.delete_all!
    test_dir_delete_all!({})?

    Stdout.line!("\nI ran all Dir function tests.")
}

test_dir_create! = |{}| {
    Stdout.line!("Testing Dir.create!:")?

    # Test creating a single directory
    test_dir_name = "test_dir_create"
    Dir.create!(test_dir_name)?

    # Verify directory exists using ls
    ls_output =
        Cmd.new("ls")
        .args(["-ld", test_dir_name])
        .exec_output!()?
    is_dir = Str.starts_with(ls_output.stdout_utf8, "d")

    Stdout.line!("Created directory: ${test_dir_name}\nIs a directory: ${Str.inspect(is_dir)}\nDirectory listing: ${Str.trim_end(ls_output.stdout_utf8)}")?

    # Test creating directory that already exists (should fail)
    create_existing_result =
        match Dir.create!(test_dir_name) {
            Ok({}) => "Unexpected success"
            Err(_) => "Expected error"
        }

    Stdout.line!("Creating existing directory result: ${create_existing_result}")?

    # Test creating directory with non-existent parent (should fail)
    nested_without_parent = "non_existent_parent/test_dir"
    create_nested_result =
        match Dir.create!(nested_without_parent) {
            Ok({}) => "Unexpected success"
            Err(_) => "Expected error"
        }

    Stdout.line!("Creating directory without parent result: ${create_nested_result}")?

    Ok({})
}

test_dir_create_all! = |{}| {
    Stdout.line!("\nTesting Dir.create_all!:")?

    # Test creating nested directories
    nested_path = "test_parent_all/test_child_all/test_grandchild_all"
    Dir.create_all!(nested_path)?

    # Verify nested structure with find
    find_output =
        Cmd.new("find")
        .args(["test_parent_all", "-type", "d"])
        .exec_output!()?

    # Count directories created (including the parent)
    dir_lines = List.keep_if(Str.split_on(find_output.stdout_utf8, "\n"), |line| !Str.is_empty(Str.trim(line)))
    dir_count = List.len(dir_lines)

    Stdout.line!("Nested directory structure:\n${find_output.stdout_utf8}\nNumber of directories created: ${dir_count.to_str()}\nExpected 3 directories: ${Str.inspect(dir_count == 3)}")?

    # Test creating directory that already exists with create_all (should succeed)
    Dir.create_all!(nested_path)?

    # Verify it still exists
    _ = Cmd.exec!("test", ["-e", nested_path])?

    # Test creating a single directory with create_all
    single_with_create_all = "test_single_with_create_all"
    Dir.create_all!(single_with_create_all)?

    _ = Cmd.exec!("test", ["-e", single_with_create_all])?

    Ok({})
}

test_dir_delete_empty! = |{}| {
    Stdout.line!("\nTesting Dir.delete_empty!:")?

    # Create an empty directory
    empty_dir = "test_empty_for_delete"
    Dir.create!(empty_dir)?

    # Verify it exists
    _ = Cmd.exec!("test", ["-e", empty_dir])?

    # Delete the empty directory
    Dir.delete_empty!(empty_dir)?

    # Verify it's gone
    exists_res = Cmd.exec!("test", ["-e", empty_dir])

    Stdout.line!("Empty directory exists after delete: ${Str.inspect(!Try.is_err(exists_res))}")?

    # Test deleting non-empty directory (should fail)
    non_empty_dir = "test_non_empty_for_delete"
    Dir.create!(non_empty_dir)?

    # Add a file to make it non-empty
    File.write_utf8!("${non_empty_dir}/test_file.txt", "test content")?

    # Try to delete non-empty directory
    delete_non_empty_result =
        match Dir.delete_empty!(non_empty_dir) {
            Ok({}) => "Unexpected success"
            Err(_) => "Expected error"
        }

    Stdout.line!("Deleting non-empty directory result: ${delete_non_empty_result}")?

    # Verify non-empty directory still exists
    _ = Cmd.exec!("test", ["-e", non_empty_dir])?

    # Test deleting non-existent directory (should fail)
    delete_nonexistent_result =
        match Dir.delete_empty!("non_existent_directory") {
            Ok({}) => "Unexpected success"
            Err(_) => "Expected error"
        }

    Stdout.line!("Deleting non-existent directory result: ${delete_nonexistent_result}")?

    Ok({})
}

test_dir_delete_all! = |{}| {
    Stdout.line!("\nTesting Dir.delete_all!:")?

    # Create directory with nested structure and files
    complex_dir = "test_complex_for_delete_all"
    Dir.create_all!("${complex_dir}/subdir1/subsubdir")?
    Dir.create_all!("${complex_dir}/subdir2")?

    # Add some files
    File.write_utf8!("${complex_dir}/file1.txt", "file1 content")?
    File.write_utf8!("${complex_dir}/subdir1/file2.txt", "file2 content")?
    File.write_utf8!("${complex_dir}/subdir1/subsubdir/file3.txt", "file3 content")?
    File.write_utf8!("${complex_dir}/subdir2/file4.txt", "file4 content")?

    # Show the structure before deletion
    tree_output =
        Cmd.new("find")
        .args([complex_dir, "-type", "f"])
        .exec_output!()?

    non_empty_lines = List.keep_if(Str.split_on(tree_output.stdout_utf8, "\n"), |line| !Str.is_empty(Str.trim(line)))
    file_lines =
        List.sort_with(
            non_empty_lines,
            |str_a, str_b| {
                # We just want consistent ordering for testing
                byte_sum_a : U64
                byte_sum_a = List.sum(List.map(Str.to_utf8(str_a), |b| b.to_u64()))
                byte_sum_b : U64
                byte_sum_b = List.sum(List.map(Str.to_utf8(str_b), |b| b.to_u64()))

                if byte_sum_a < byte_sum_b {
                    LT
                } else if byte_sum_a > byte_sum_b {
                    GT
                } else {
                    EQ
                }
            },
        )
    file_count = List.len(file_lines)
    file_lines_str = Str.join_with(file_lines, "\n")

    Stdout.line!("Files in complex directory structure:\n${file_lines_str}\nNumber of files: ${file_count.to_str()}")?

    # Delete the entire directory structure
    Dir.delete_all!(complex_dir)?

    # Verify it's gone
    exists_res = Cmd.exec!("test", ["-e", complex_dir])

    Stdout.line!("Complex directory is gone after delete_all: ${Str.inspect(Try.is_err(exists_res))}")?

    # Test deleting non-existent directory with delete_all (should fail)
    delete_all_nonexistent_result =
        match Dir.delete_all!("non_existent_directory_for_delete_all") {
            Ok({}) => "Unexpected success"
            Err(_) => "Expected error"
        }

    Stdout.line!("Deleting non-existent directory with delete_all result: ${delete_all_nonexistent_result}")?

    # Clean up the non-empty directory from previous test
    Dir.delete_all!("test_non_empty_for_delete")?

    Ok({})
}

cleanup_test_dirs! = |dirs_requirement| {
    Stdout.line!("\nCleaning up test directories...")?

    test_dirs = [
        "test_dir_create",
        "test_parent_all",
        "test_single_with_create_all",
        "test_non_empty_for_delete",
    ]

    # Clean up directories that exist, ignoring missing ones
    delete_result = || {
        for dir_name in test_dirs {
            # Check if directory exists first
            exists_res = Cmd.exec!("test", ["-e", dir_name])

            match exists_res {
                Ok(_) =>
                    # Directory exists, try to delete it
                    match Dir.delete_empty!(dir_name) {
                        Ok({}) => {}
                        Err(_) => Dir.delete_all!(dir_name)?
                    }
                Err(_) =>
                    # Directory doesn't exist, which is fine for cleanup
                    {}
            }
        }
        Ok({})
    }

    result = delete_result()

    match dirs_requirement {
        DirsNeedToExist => result?
        DirsMaybeExist => Ok({})?
    }

    Stdout.line!("Cleanup completed.")
}

respond! : Http.Request, Model => Try(Http.Response, [ServerErr(Str), ..])
respond! = |_request, _model|
    Ok({ status: 200, headers: [], body: Str.to_utf8("I am a test.") })
