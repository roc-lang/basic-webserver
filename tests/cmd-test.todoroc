app [Model, program] { pf: platform "../platform/main.roc" }

import pf.Stdout
import pf.Stderr
import pf.Http
import pf.Cmd

Model : {}

program = { init!, respond! }

init! : {} => Try(Model, [Exit(I64), ..])
init! = |{}|
    match run_tests!({}) {
        Ok(_) => {
            _ = Stdout.line!("Done.")
            Err(Exit(0))
        }
        Err(err) => {
            _ = Stderr.line!("Test run failed:\n\t${Str.inspect(err)}")
            Err(Exit(1))
        }
    }

run_tests! = |{}| {

    # exec!
    expect_str_eq(
        Str.inspect(Cmd.exec!("blablaXYZ", [])),
        "Err(FailedToGetExitCode({ command: \"{ cmd: blablaXYZ, args:  }\", err: NotFound }))",
    )?

    expect_str_eq(
        Str.inspect(Cmd.exec!("cat", ["non_existent.txt"])),
        "Err(ExecFailed({ command: \"cat non_existent.txt\", exit_code: 1 }))",
    )?

    # exec_cmd!
    expect_str_eq(
        Str.inspect(Cmd.new("blablaXYZ").exec_cmd!()),
        "Err(FailedToGetExitCode({ command: \"{ cmd: blablaXYZ, args:  }\", err: NotFound }))",
    )?

    expect_str_eq(
        Str.inspect(Cmd.new("cat").arg("non_existent.txt").exec_cmd!()),
        "Err(ExecCmdFailed({ command: \"{ cmd: cat, args: non_existent.txt }\", exit_code: 1 }))",
    )?

    # exec_output!
    expect_str_eq(
        Str.inspect(Cmd.new("blablaXYZ").exec_output!()),
        "Err(FailedToGetExitCode({ command: \"{ cmd: blablaXYZ, args:  }\", err: NotFound }))",
    )?

    expect_str_eq(
        Str.inspect(Cmd.new("cat").arg("non_existent.txt").exec_output!()),
        "Err(NonZeroExitCode({ command: \"{ cmd: cat, args: non_existent.txt }\", exit_code: 1, stderr_utf8_lossy: \"cat: non_existent.txt: No such file or directory\n\", stdout_utf8_lossy: \"\" }))",
    )?

    # Test StdoutContainsInvalidUtf8 - using printf to output invalid UTF-8 bytes
    expect_str_eq(
        Str.inspect(Cmd.new("printf").args(["\\377\\376"]).exec_output!()),
        "Err(StdoutContainsInvalidUtf8({ err: BadUtf8({ index: 0, problem: InvalidStartByte }), cmd_str: \"{ cmd: printf, args: \\\\377\\\\376 }\" }))",
    )?

    # exec_output_bytes!
    expect_str_eq(
        Str.inspect(Cmd.new("blablaXYZ").exec_output_bytes!()),
        "Err(FailedToGetExitCodeB(NotFound))",
    )?

    expect_str_eq(
        Str.inspect(Cmd.new("cat").arg("non_existent.txt").exec_output_bytes!()),
        "Err(NonZeroExitCodeB({ exit_code: 1, stderr_bytes: [99, 97, 116, 58, 32, 110, 111, 110, 95, 101, 120, 105, 115, 116, 101, 110, 116, 46, 116, 120, 116, 58, 32, 78, 111, 32, 115, 117, 99, 104, 32, 102, 105, 108, 101, 32, 111, 114, 32, 100, 105, 114, 101, 99, 116, 111, 114, 121, 10], stdout_bytes: [] }))",
    )?

    # exec_exit_code!
    expect_str_eq(
        Str.inspect(Cmd.new("blablaXYZ").exec_exit_code!()),
        "Err(FailedToGetExitCode({ command: \"{ cmd: blablaXYZ, args:  }\", err: NotFound }))",
    )?

    # exec_exit_code! with non-zero exit code is not an error - it returns the exit code
    exit_code =
        Cmd.new("cat")
        .arg("non_existent.txt")
        .exec_exit_code!()?

    expect_str_eq(Str.inspect(exit_code), "1")?

    Stdout.line!("All tests passed.")?

    Ok({})
}

expect_str_eq = |actual_str, expected_str|
    if actual_str == expected_str {
        Ok({})
    } else {
        Err(FailedExpectation("\n\n- Expected:\n${expected_str}\n\n- Got:\n${actual_str}\n"))
    }

respond! : Http.Request, Model => Try(Http.Response, [ServerErr(Str), ..])
respond! = |_request, _model|
    Ok({ status: 200, headers: [], body: Str.to_utf8("I am a test.") })
