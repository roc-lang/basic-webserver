#!/usr/bin/expect

set timeout 7

source ./ci/expect_scripts/shared-code.exp

spawn $env(TESTS_DIR)url

set expected_output [normalize_output "
Canonical literal: https://example.com/hello%20world\\?q=roc#frag
Built URL: http://127.0.0.1:8080/base/api/todo%20item\\?status=in\\+progress
Resolved URL: http://127.0.0.1:8080/todos\\?task=write\\+tests&task=ship
Rejected relative URL without a base.
Ran all tests.
"]

expect -re $expected_output {
    expect eof {
        check_exit_and_segfault
    }
}

puts stderr "\nExpect script failed: output was not as expected."
exit 1
