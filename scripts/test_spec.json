    {
      "path": "examples/todos.roc",
      "mode": "server",
      "cases": [
        {
          "name": "routes-and-database",
          "fixtures": [
            {
              "source": "{root}/examples/todos.db",
              "dest": "{temp}/todos.db"
            }
          ],
          "env": {
            "DB_PATH": "{temp}/todos.db"
          },
          "requests": [
            {
              "method": "GET",
              "target": "/",
              "body_contains": ["addTodoForm"]
            },
            {
              "method": "GET",
              "target": "/todos",
              "response_headers": {
                "Content-Type": "application/json; charset=utf-8"
              },
              "body_contains": ["Prepare for AoC"]
            },
            {
              "method": "POST",
              "target": "/todos",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "{\"task\":\"Spec task\",\"status\":\"completed\"}",
              "body_contains": ["Spec task", "completed"]
            },
            {
              "method": "GET",
              "target": "/todos",
              "body_contains": ["Spec task"]
            },
            {
              "method": "POST",
              "target": "/todos",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "{}",
              "status": 400,
              "expect_body": "Expected JSON with string fields \"task\" and \"status\"."
            },
            {
              "method": "POST",
              "target": "/todos",
              "headers": {
                "Content-Type": "application/json"
              },
              "body": "{\"task\":\"Invalid status\",\"status\":\"unknown\"}",
              "status": 400,
              "expect_body": "Status must be \"todo\", \"planned\", \"completed\", or \"in-progress\"."
            },
            {
              "method": "DELETE",
              "target": "/todos",
              "status": 405,
              "body_contains": ["HTTP method DELETE is not supported"]
            },
            {
              "method": "GET",
              "target": "/missing",
              "status": 404,
              "expect_body": "URL Not Found (404)"
            }
          ]
        }
      ]
    },
    {
      "path": "examples/ndjson-ingest.roc",
      "mode": "server",
      "cases": [
        {
          "name": "streaming-events",
          "env": {
            "DB_PATH": "{temp}/events.db"
          },
          "requests": [
            {
              "method": "POST",
              "target": "/events",
              "headers": {
                "Content-Type": "application/x-ndjson"
              },
              "body": "{\"id\":\"evt-1\",\"source\":\"sensor\",\"value\":1}\n{\"id\":\"evt-2\",\"source\":\"sensor\",\"value\":2}\n{\"id\":\"evt-3\",\"source\":\"sensor\",\"value\":3}\n",
              "expect_body": "{\"committed\":3}"
            },
            {
              "method": "GET",
              "target": "/events/count",
              "expect_body": "{\"count\":3}"
            },
            {
              "raw": true,
              "half_close": false,
              "fragments": [
                {
                  "data": "POST /events HTTP/1.1\r\nHost: localhost\r\nContent-Type: application/x-ndjson\r\nContent-Length: 44\r\nConnection: close\r\n\r\n{\"id\":\"raw-1\",\"source\":\"sen",
                  "delay_ms": 10
                },
                {
                  "data": "sor\",\"value\":9}\r",
                  "delay_ms": 10
                },
                {
                  "data": "\n"
                }
              ],
              "response_contains": [
                "HTTP/1.1 200 OK",
                "{\"committed\":1}"
              ]
            },
            {
              "method": "POST",
              "target": "/events",
              "headers": {
                "Content-Type": "application/x-ndjson"
              },
              "body": "{\"id\":\"evt-1\",\"source\":\"sensor\",\"value\":1}\n{\"id\":\"evt-4\",\"source\":\"sensor\",\"value\":4}\n",
              "expect_body": "{\"committed\":2}"
            },
            {
              "method": "GET",
              "target": "/events/count",
              "expect_body": "{\"count\":5}"
            },
            {
              "method": "POST",
              "target": "/events",
              "headers": {
                "Content-Type": "application/x-ndjson"
              },
              "body": "{\"id\":\"truncated\",\"source\":\"sensor\",\"value\":5}",
              "status": 400,
              "body_contains": ["missing its final newline", "\"committed\":0"]
            }
          ]
        }
      ]
    },
