{
  "stages": {
    "fmt": true,
    "check": true,
    "test": true,
    "build": true,
    "run": true
  },
  "apps": [
    {
      "path": "examples/command.roc",
      "mode": "server",
      "cases": [
        {
          "name": "commands-and-request",
          "env": {
            "PYTHON": "{python}",
            "COMMAND_HELPER": "{root}/scripts/command_helper.py",
            "COMMAND_EXAMPLES_DIR": "{root}/examples",
            "COMMAND_SCRIPTS_DIR": "{root}/scripts"
          },
          "requests": [
            {
              "method": "GET",
              "target": "/",
              "expect_body": "Command succeeded."
            },
            {
              "method": "GET",
              "target": "/timeout",
              "expect_body": "Command timed out."
            },
            {
              "method": "GET",
              "target": "/output-limit",
              "expect_body": "Command output was limited."
            }
          ],
          "concurrent_requests": [
            {
              "target": "/cwd-examples",
              "expect_body": "examples\n"
            },
            {
              "launch_after_ms": 20,
              "target": "/cwd-scripts",
              "expect_body": "scripts\n"
            }
          ],
          "stdout_contains": [
            "Hello",
            "stdout_utf8: \"Hi",
            "Exit code: 1",
            "stdout_bytes: [72, 105, 10]"
          ],
          "stdout_regex": [
            "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z GET /"
          ]
        }
      ]
    },
    {
      "path": "examples/dir.roc",
      "mode": "server",
      "cases": [
        {
          "name": "lists-examples",
          "requests": [
            {
              "body_contains": ["dir.roc"]
            }
          ],
          "stdout_contains": [
            "Entries in examples/:",
            "dir.roc"
          ]
        }
      ]
    },
    {
      "path": "examples/echo.roc",
      "mode": "server",
      "cases": [
        {
          "name": "utf8-and-binary",
          "requests": [
            {
              "method": "POST",
              "target": "/echo?kind=utf8",
              "body": "echo me",
              "expect_body": "echo me"
            },
            {
              "method": "POST",
              "target": "/binary",
              "body_hex": "00ff410a",
              "expect_body_hex": "00ff410a"
            },
            {
              "method": "POST",
              "target": "/first-chunk",
              "body": "seamless response",
              "expect_body": "seamless response"
            },
            {
              "method": "POST",
              "target": "/compressed",
              "headers": {
                "Accept-Encoding": "br;q=0.5, gzip;q=1"
              },
              "body_repeat": "compressible echo body ",
              "body_size_bytes": 4096,
              "decode_response": "gzip",
              "expect_body_bytes": 4096,
              "body_contains": [
                "compressible echo body"
              ],
              "response_headers": {
                "Content-Encoding": "gzip",
                "Vary": "Accept-Encoding"
              }
            },
            {
              "method": "POST",
              "target": "/zstandard",
              "headers": {
                "Accept-Encoding": "gzip;q=0.5, br;q=0.5, zstd"
              },
              "body_repeat": "compressible zstandard body ",
              "body_size_bytes": 4096,
              "response_headers": {
                "Content-Encoding": "zstd",
                "Vary": "Accept-Encoding"
              }
            },
            {
              "raw": true,
              "half_close": false,
              "data_hex": "474554202f20485454502f312e310d0a486f73743a203132372e302e302e310d0a582d546573743a20ff0d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a",
              "response_contains": [
                "HTTP/1.1 400 Bad Request",
                "Request header values must be valid UTF-8"
              ]
            }
          ],
          "concurrent_requests": [
            {
              "method": "POST",
              "target": "/first-chunk",
              "body": "first concurrent body",
              "expect_body": "first concurrent body"
            },
            {
              "method": "POST",
              "target": "/first-chunk",
              "body": "second concurrent body",
              "expect_body": "second concurrent body"
            }
          ],
          "stdout_contains": [
            "POST /echo?kind=utf8",
            "POST /binary",
            "POST /first-chunk"
          ]
        }
      ]
    },
    {
      "path": "examples/env.roc",
      "mode": "server",
      "cases": [
        {
          "name": "debug-disabled",
          "unset_env": ["DEBUG"],
          "requests": [
            {
              "expect_body": "DEBUG var not set"
            }
          ]
        },
        {
          "name": "debug-enabled",
          "env": {
            "DEBUG": "1",
            "BASIC_WEBSERVER_SPEC_VALUE": "present"
          },
          "requests": [
            {
              "body_contains": ["BASIC_WEBSERVER_SPEC_VALUE", "present"]
            }
          ]
        }
      ]
    },
    {
      "path": "examples/error-handling.roc",
      "mode": "server",
      "cases": [
        {
          "name": "outbound-http",
          "helper": "http",
          "env": {
            "TARGET_URL": "http://127.0.0.1:9000/example"
          },
          "requests": [
            {
              "expect_body": "<html><body>Example Domain</body></html>"
            }
          ],
          "stdout_regex": [
            "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z GET /"
          ]
        },
        {
          "name": "semantic-error-fallback",
          "env": {
            "TARGET_URL": "http://127.0.0.1:1/unavailable"
          },
          "requests": [
            {
              "status": 500,
              "expect_body": "Internal Server Error"
            }
          ],
          "stderr_contains": [
            "ERROR respond! method=GET target=\"/\": FailedToFetch("
          ]
        }
      ]
    },
