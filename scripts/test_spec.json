    {
      "path": "examples/form-file-upload.roc",
      "mode": "server",
      "cases": [
        {
          "name": "get-and-upload",
          "requests": [
            {
              "method": "GET",
              "response_headers": {
                "Content-Type": "text/html; charset=utf-8"
              },
              "body_contains": ["Upload an Image", "multipart/form-data"]
            },
            {
              "method": "POST",
              "multipart": [
                {
                  "name": "fileToUpload",
                  "filename": "tiny.png",
                  "content_type": "image/png",
                  "data_hex": "89504e470d0a1a0a"
                },
                {
                  "name": "submit",
                  "data": "Upload .png Image"
                }
              ],
              "body_contains": [
                "You uploaded:",
                "iVBORw0KGgo="
              ]
            },
            {
              "method": "POST",
              "multipart": [
                {
                  "name": "fileToUpload",
                  "filename": "not-an-image.txt",
                  "content_type": "text/plain",
                  "data": "not a png"
                }
              ],
              "status": 400,
              "expect_body": "Expected a PNG in the fileToUpload field."
            }
          ]
        }
      ]
    },
    {
      "path": "examples/form-url-encoded.roc",
      "mode": "server",
      "build_opt": "dev",
      "cases": [
        {
          "name": "get-post-and-method-rejection",
          "requests": [
            {
              "method": "GET",
              "body_contains": ["Submit Form Data"]
            },
            {
              "method": "POST",
              "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
              },
              "body": "name=Test+User&email=test%40example.com&message=This+is+a+test",
              "body_contains": [
                "Form Data Received:",
                "Test User",
                "test@example.com",
                "This is a test"
              ]
            },
            {
              "method": "POST",
              "headers": {
                "Content-Type": "application/x-www-form-urlencoded"
              },
              "body": "message=%3Cscript%3Ealert%281%29%3C%2Fscript%3E",
              "body_contains": [
                "&lt;script&gt;alert(1)&lt;/script&gt;"
              ]
            },
            {
              "method": "DELETE",
              "status": 405,
              "expect_body": ""
            }
          ]
        }
      ]
    },
    {
      "path": "examples/hello-web.roc",
      "mode": "server",
      "cases": [
