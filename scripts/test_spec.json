    {
      "path": "examples/sleep.roc",
      "mode": "server",
      "cases": [
        {
          "name": "delayed-response",
          "timeout": 12,
          "requests": [
            {
              "expect_body": "Response delayed by 1 second",
              "timeout": 3
            }
          ],
          "concurrent_requests": [
            {
              "expect_body": "Response delayed by 1 second",
              "timeout": 4
            },
            {
              "launch_after_ms": 50,
              "expect_body": "Response delayed by 1 second",
              "timeout": 4
            },
            {
              "launch_after_ms": 100,
              "expect_body": "Response delayed by 1 second",
              "timeout": 4
            },
            {
              "launch_after_ms": 150,
              "status": 503,
              "expect_body": "Server is overloaded"
            }
          ],
          "http2_requests": [
            {
              "name": "slow",
              "method": "POST",
              "target": "/body-slow",
              "body": "slow HTTP/2 body",
              "expect_body": "slow HTTP/2 body"
            },
            {
              "name": "fast",
              "method": "POST",
              "target": "/body-fast",
              "body": "fast HTTP/2 body",
              "expect_body": "fast HTTP/2 body"
            }
          ],
          "http2_completion_order": ["fast", "slow"],
          "stdout_contains": ["Sleeping for 1 second..."]
        }
      ]
    },
